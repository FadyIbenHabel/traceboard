{
  "name": "traceboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run repo:check",
    "repo:check": "node scripts/check-repository.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "10.14.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.7",
    "wrangler": "4.160.0",
    "prettier": "^3.7.4",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "8.72.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.0.0"
  },
  "type": "module",
  "description": "Evidence-first debugging briefs with BM25 retrieval, validated source citations, a no-key demo, and optional Groq inference.",
  "license": "MIT",
  "overrides": {
    "fflate": "0.8.3",
    "minimatch": "11.0.5"
  }
}
